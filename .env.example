# isoom (아이숨) Backend Environment Configuration
# 절대 이 파일에 실제 비밀 키를 입력하여 커밋하지 마세요. (복사하여 .env 생성 후 사용)
# GCP 서비스(Vertex AI Gemini, Cloud Firestore)는 API Key / JSON 키 파일 대신 ADC 인증을 사용합니다.
# 로컬 개발 시 사전 인증: `gcloud auth application-default login`

# 1. 공공데이터포털 디코딩(Decoding) 인증키 (비-GCP 외부 API)
# 국립중앙의료원(NMC) E-Gen 응급실/약국 API 및 한국천문연구원(KASI) 특일 API 공용
DATA_GO_API_KEY=your_decoding_service_key_here

# 2. Google Cloud ADC (Vertex AI Gemini & Cloud Firestore 무키 인증)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
FIRESTORE_DATABASE_ID=isoom
# GEMINI_TRIAGE_MODEL=gemini-3.8-flash
# GEMINI_LOGISTICS_MODEL=gemini-3.5-flash-lite

# 3. 카카오 로컬 REST API 키 (비-GCP 외부 API, 주소/좌표 역지오코딩)
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# 5. 앱 런타임 & 보안 설정
APP_ENV=development
LOG_LEVEL=INFO
# 운영 환경(APP_ENV=production)에서는 아래 보안/세션 설정 권장
# ALLOWED_ORIGINS=https://your-domain.example.com
# ADMIN_API_TOKEN=replace-with-strong-random-token
# SESSION_SECRET=replace-with-strong-random-secret
# REQUIRE_SESSION_TOKEN=false
# SESSION_STORE_BACKEND=memory
# ENABLE_IN_PROCESS_SCHEDULER=true
