# MoonlightCare Backend Environment Configuration
# 절대 이 파일에 실제 비밀 키를 입력하여 커밋하지 마세요. (복사하여 .env 생성 후 사용)

# 1. 공공데이터포털 디코딩(Decoding) 인증키
# 국립중앙의료원(NMC) E-Gen 응급실/약국 API 및 한국천문연구원(KASI) 특일 API 공용
DATA_GO_API_KEY=your_decoding_service_key_here

# 2. Google Gemini API Key (Step 3 AI 에이전트 결합용)
# Google AI Studio에서 발급받은 API 키 (Gemini 3.8 Flash, 3.5 Flash-Lite)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Firebase Admin SDK 서비스 계정 비공개 키 JSON 경로 및 Firestore 데이터베이스 ID
# Firebase Console > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성
# 기본값: C:\AI-Native-Agent\key\serviceAccountKey.json 또는 프로젝트 루트의 serviceAccountKey.json
FIREBASE_KEY_PATH=C:\AI-Native-Agent\key\serviceAccountKey.json
FIRESTORE_DATABASE_ID=data-test01

# 4. 앱 런타임 설정 (선택 사항)
APP_ENV=development
LOG_LEVEL=INFO
